# Optional: full origin of the Apimetro API (no trailing slash).
# Leave empty during local dev to use the Vite proxy (see vite.config.ts → /movilidad → :8080).
#
# Production (same domain as this UI): leave unset so fetch("/movilidad/...") hits the API on the same host.
# Example if UI and API differ during testing:
# VITE_APIMETRO_BASE_URL=https://apimetro.dev

VITE_APIMETRO_BASE_URL=
